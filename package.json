{
  "name": "pi-sticky-prompt",
  "version": "0.1.0",
  "description": "Pi extension: sticky header that pins the user prompt for the transcript region in view (fullscreen mode)",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": ["index.ts", "src", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bline/pi-sticky-prompt.git"
  },
  "homepage": "https://github.com/bline/pi-sticky-prompt#readme",
  "bugs": "https://github.com/bline/pi-sticky-prompt/issues",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
